# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Single Google Cloud API Key with Maps JS, Places, Geocoding, and Routes APIs enabled.
GOOGLE_MAPS_API_KEY=""

# FIRECRAWL_API_KEY: Optional key for crawling and scraping custom URLs directly.
FIRECRAWL_API_KEY=""

# DEEPGRAM REAL-TIME CONVERSATIONAL VOICE SETTINGS (Optional / Custom)
DEEPGRAM_API_KEY=""
DEEPGRAM_ADMIN_API_KEY=""
DEEPGRAM_PROJECT_ID=""
DEEPGRAM_AGENT_ID="470277c9-c238-4208-9fef-6b3b126da261"
VITE_DEEPGRAM_API_KEY=""
VITE_DEEPGRAM_ADMIN_API_KEY=""
VITE_DEEPGRAM_PROJECT_ID=""
VITE_DEEPGRAM_AGENT_ID="470277c9-c238-4208-9fef-6b3b126da261"

# STRIPE API SETTINGS (For P.A.C. payment link & 50% deposit creation)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# OLLAMA QWEN2.5 G14 / MAC LOCAL TUNNEL SETTINGS
# Base URL for Ollama local server or Cloudflare/Ngrok/Pinggy tunnel to G14/Mac (e.g. https://numbly-clapping-filling.ngrok-free.dev or https://your-subdomain.trycloudflare.com)
OLLAMA_BASE_URL="https://numbly-clapping-filling.ngrok-free.dev"
# Ollama Model Name (e.g., qwen2.5:7b-instruct-q4_k_m, qwen2.5, qwen2.5:14b)
OLLAMA_MODEL="qwen2.5:7b-instruct-q4_k_m"
# LLM Provider strategy: 'auto' (detects Ollama tunnel first, falls back to Gemini), 'ollama', or 'gemini'
LLM_PROVIDER="auto"

# N8N AUTOMATION WEBHOOK SETTINGS (Port 5678)
# Webhook URL for n8n email/outreach triggers running on port 5678 via Ngrok or Cloudflare tunnel
N8N_EMAIL_WEBHOOK_URL="https://numbly-clapping-filling.ngrok-free.dev/webhook/send-email"


