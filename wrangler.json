{
  "name": "problems-solutions",
  "main": "server.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "GEMINI_GENERATE_MODEL": "gemini-3.8-flash",
    "GEMINI_LIVE_MODEL": "gemini-3.8-live"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "missedrevenue.org/*",
      "custom_domain": false
    },
    {
      "pattern": "www.missedrevenue.org/*",
      "custom_domain": false
    }
  ]
}
